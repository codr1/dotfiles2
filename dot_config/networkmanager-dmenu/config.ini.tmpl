{{- $t := index .themes .theme -}}
# networkmanager-dmenu - managed by chezmoi
# Theme: {{ $t.name }} | Backend: wofi (matches the rest of the dotfiles2 launcher stack)

[dmenu]
dmenu_command = wofi --dmenu --prompt="Network"
active_chars = ==
highlight = True
highlight_fg = {{ $t.foreground }}
highlight_bg = {{ $t.primary }}
highlight_bold = True
compact = False
wifi_chars = ▂▄▆█
format = {name}  {sec}  {bars}
list_saved = False
prompt = Networks

[dmenu_passphrase]
# Cleartext. obscure = True would mask the password (via wofi -P), but
# wofi's password mode also suppresses the -p prompt label — so the user
# sees an empty input box with no indication it's asking for a wifi
# password. Trading masking for label visibility: the "Passphrase" prompt
# placeholder is now visible the same way "Networks" is visible on the
# picker. Don't enter wifi passwords with someone watching your screen.
obscure = False

[editor]
# Falls back to a terminal nmtui-style editor when nm-connection-editor
# isn't installed. With nm-connection-editor present (recommended), the
# "Edit Connections" menu entry opens the GUI directly.
terminal = foot
