{{- $t := index .themes .theme -}}
# networkmanager-dmenu - managed by chezmoi
# Theme: {{ $t.name }} | Backend: wofi (matches the rest of the dotfiles2 launcher stack)

[dmenu]
dmenu_command = wofi --dmenu --prompt="Network"
active_chars = ==
highlight = True
highlight_fg = {{ $t.foreground }}
highlight_bg = {{ $t.primary }}
highlight_bold = True
compact = False
wifi_chars = ▂▄▆█
format = {name}  {sec}  {bars}
list_saved = False
prompt = Networks

[dmenu_passphrase]
# Required for the password prompt to actually mask input on wofi/rofi/etc.
# Without this, networkmanager-dmenu launches the menu in regular dmenu mode
# and the "type your wifi password" step looks like an empty search box.
obscure = True

[editor]
# Falls back to a terminal nmtui-style editor when nm-connection-editor
# isn't installed. With nm-connection-editor present (recommended), the
# "Edit Connections" menu entry opens the GUI directly.
terminal = foot
