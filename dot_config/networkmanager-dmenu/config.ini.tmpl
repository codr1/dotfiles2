{{- $t := index .themes .theme -}}
# networkmanager-dmenu - managed by chezmoi
# Theme: {{ $t.name }} | Backend: wofi (matches the rest of the dotfiles2 launcher stack)

[dmenu]
dmenu_command = wofi --dmenu --prompt="Network"
active_chars = ==
highlight = True
highlight_fg = {{ $t.foreground }}
highlight_bg = {{ $t.primary }}
highlight_bold = True
compact = False
wifi_chars = ▂▄▆█
format = {name}  {sec}  {bars}
list_saved = False
prompt = Networks

[editor]
# nm-connection-editor is an optional dep; install it if you want the
# "Edit Connections" menu entry to actually open a GUI editor.
terminal = foot
