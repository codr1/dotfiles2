{{- $t := index .themes .theme -}}
/* {{ $t.name }} theme for wofi - managed by chezmoi */

* {
    font-family: JetBrains Mono;
}

window {
    margin: 0px;
    border: 2px solid {{ $t.primary }};
    border-radius: 8px;
    background-color: {{ $t.background }};
    font-size: 15px;
}

#input {
    margin: 10px;
    padding: 10px;
    border: none;
    border-radius: 4px;
    background-color: {{ $t.background_darker }};
    color: {{ $t.foreground }};
    font-family: JetBrains Mono;
    font-size: 16px;
}

/* Hide the GtkSearchEntry magnifying-glass icon — it makes the input look
 * like a search box, which is misleading for prompts like "Passphrase". */
#input image {
    min-width: 0;
    min-height: 0;
    color: transparent;
    background: transparent;
    -gtk-icon-source: none;
}

/* NOTE: we explored styling wofi's placeholder text to make the prompt
 * (passed via -p) more visible — GTK CSS doesn't reliably expose a
 * placeholder pseudo-element across GTK3/GTK4/wofi versions, and any
 * attempt with -gtk-placeholder-color trips the GTK CSS parser. The
 * underlying limitation is real: wofi has no concept of a separate
 * label above the input. For prompts that need a visible "what is
 * this asking for" cue (e.g. wifi password entry), use pinentry-gnome3
 * instead — networkmanager-dmenu has a `pinentry =` config option
 * specifically for this. */

#inner-box {
    margin: 10px;
    border: none;
    background-color: transparent;
}

#outer-box {
    margin: 0px;
    padding: 2rem;
    border: none;
    background-color: transparent;
}

#scroll {
    margin: 0px;
    border: none;
}

#text {
    margin: 5px;
    border: none;
    color: {{ $t.foreground }};
    font-family: JetBrains Mono;
}

#entry {
    padding: 8px;
    border-radius: 4px;
    background-color: transparent;
    font-family: JetBrains Mono;
}

#entry:selected {
    background-color: {{ $t.primary }};
}

#entry:selected #text {
    color: {{ $t.background }};
    font-weight: bold;
}

#entry:hover {
    background-color: {{ $t.background_alt }};
}
