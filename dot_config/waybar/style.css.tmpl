{{- $t := index .themes .theme -}}
/* {{ $t.name }} theme for waybar - managed by chezmoi */

#waybar {
  font-family:
    "JetBrainsMono Nerd Font",
    "JetBrains Mono",
    Hack,
    Cantarell,
    Noto Sans;
  font-size: 16px;
}

/* Floating-pill bar: the window itself is transparent, individual outer
 * modules/groups carry the dark pill background. */
window#waybar {
  border: none;
  border-radius: 0;
  box-shadow: none;
  text-shadow: none;
  transition-duration: 0s;
  color: {{ $t.foreground }};
  background-color: transparent;
}

/* Pill style for every outer module + group. Same bar background as before
 * the rewrite ({{`{{ $t.bar_bg_rgba }}`}}, ~90% opaque dark). 10px radius,
 * 6px vertical / 12px horizontal interior padding, 0 vertical / 6px
 * horizontal outer margin.
 *
 * Vertical margin is 0 (not 4) so pills fill the bar's exclusive-zone
 * height edge-to-edge — otherwise waybar computes a taller minimum
 * (~46px) to fit content + margin, sway reserves that extra height,
 * and the ~6px of leftover space renders as an asymmetric bottom gap
 * between the pills and the first tile. Padding still gives interior
 * breathing room; horizontal 6px margin still separates pills from
 * each other. */
#workspaces,
#window,
#clock,
#system,
#connectivity,
#custom-powermenu {
  background-color: {{ $t.bar_bg_rgba }};
  border-radius: 10px;
  padding: 6px 12px;
  margin: 0 6px;
}

/* Workspaces still wraps buttons; their existing focused/visible/urgent
 * styling lives on the buttons themselves further down. */
#workspaces {
  padding: 2px 6px;
}

#workspaces button {
  padding: 0 8px;
  color: {{ $t.foreground_alt }};
  border: 3px solid transparent;
  border-radius: 10px;
  min-width: 33px;
}

#workspaces button.visible {
  color: {{ $t.foreground }};
}

#workspaces button.focused {
  border-top: 3px solid {{ $t.primary }};
  border-bottom: 3px solid {{ $t.primary }};
}

#workspaces button.urgent {
  background-color: {{ $t.orange }};
  color: {{ $t.background }};
}

#workspaces button:hover {
  box-shadow: inherit;
  border-color: {{ $t.magenta }};
  color: {{ $t.magenta }};
}

/* Repeat style here to ensure properties are overwritten as there's no !important and button:hover above resets the colour */

#workspaces button.focused {
  color: {{ $t.primary }};
}
#workspaces button.focused:hover {
  color: {{ $t.magenta }};
}

#pulseaudio {
  /* font-size: 26px; */
}

#custom-recorder {
  font-size: 18px;
  margin: 2px 7px 0px 7px;
  color: {{ $t.red }};
}

/* Spacing for modules INSIDE pills. Was a hefty 10px left-margin when
 * everything sat on a flat bar; reduced to 6px symmetric so the cluster
 * inside each pill (system/connectivity) looks balanced and doesn't push
 * the first module too far from the pill's own padding. */
#tray,
#mode,
#battery,
#temperature,
#cpu,
#memory,
#network,
#pulseaudio,
#idle_inhibitor,
#sway-language,
#backlight,
#custom-storage,
#custom-cpu_speed,
#custom-spotify,
#custom-weather,
#custom-mail,
#bluetooth,
#custom-keyboard-toggle,
#custom-media {
  margin: 0 6px;
  padding: 0;
}

/* Wifi-bars glyph hangs a few px past its nominal width; give #network extra right padding. */
#network {
  padding-right: 9px;
}

/* Clock pill — picks up base pill styling (background, border-radius,
 * padding, margin) from the shared selector above. We only set
 * clock-specific bits here: min-width to keep the time column from
 * jumping as digits change, magenta text for accent (kept from prior
 * styling — user can call this off if it's too much), and the Roboto
 * font (visually distinct from the JBM Nerd Font used elsewhere). */
#clock {
  min-width: 140px;
  color: {{ $t.magenta }};
  font-family: Roboto;
}

#battery.warning {
  color: {{ $t.yellow }};
}

#battery.critical {
  color: {{ $t.red }};
}

#battery.charging {
  color: {{ $t.foreground }};
}

#custom-storage.warning {
  color: {{ $t.yellow }};
}

#custom-storage.critical {
  color: {{ $t.red }};
}

@keyframes blink {
  to {
    background-color: #ffffff;
    color: black;
  }
}
