{{- $t := index .themes .theme -}}
{
    "_comment": "{{ $t.name }} theme - managed by chezmoi",
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 4,
    "margin-bottom": 4,
    "margin-left": 6,
    "margin-right": 6,
    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["clock"],
{{- if eq .profile "bare-metal" }}
    "modules-right": ["custom/recorder", "group/system", "group/connectivity", "custom/powermenu"],
{{- else }}
    "modules-right": ["custom/recorder", "pulseaudio", "temperature", "cpu", "memory", "network", "tray", "custom/powermenu"],
{{- end }}
{{- if eq .profile "bare-metal" }}
    "group/system": {
        "orientation": "horizontal",
        "modules": ["backlight", "temperature", "cpu", "memory"]
    },
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": ["custom/keyboard-toggle", "battery", "pulseaudio", "bluetooth", "network"]
    },
    "custom/keyboard-toggle": {
        "return-type": "json",
        "interval": 2,
        "exec-if": "{{ .chezmoi.homeDir }}/.local/bin/laptop-keyboard-toggle should-show",
        "exec": "{{ .chezmoi.homeDir }}/.local/bin/laptop-keyboard-toggle",
        "on-click": "{{ .chezmoi.homeDir }}/.local/bin/laptop-keyboard-toggle toggle",
        "format": "<span font='JetBrainsMono Nerd Font 14'>{}</span>",
        "tooltip": true
    },
{{- end }}
    "sway/mode": {
        "format": " {}"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{value}"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 8
    },
    "sway/window": {
        "max-length": 60,
        "tooltip": false
    },
    "clock": {
        "format": "{:%a %d %b - %H:%M}",
        "tooltip": false
    },
    "cpu": {
        "interval": 5,
        "format": "<span font='JetBrainsMono Nerd Font 14'></span> {usage}%",
        "tooltip-format": "CPU: {usage}%  •  load: {load}",
        "max-length": 10
    },
    "memory": {
        "interval": 15,
        "format": "<span font='JetBrainsMono Nerd Font 14'></span> {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
    },
    "custom/powermenu": {
        "return-type": "json",
        "exec": "{{ .chezmoi.homeDir }}/.config/waybar/modules/powermenu.sh",
        "format": "<span font='JetBrainsMono Nerd Font 14'>󰐥</span> {text}",
        "interval": 3600,
        "escape": true,
        "on-click": "{{ .chezmoi.homeDir }}/.config/wofi/wofi-power.sh"
    },

    "custom/recorder": {
        "format": "!",
        "return-type": "json",
        "interval": 3,
        "exec": "echo '{\"class\": \"recording\"}'",
        "exec-if": "pgrep wf-recorder",
        "tooltip": false,
        "on-click": "killall -s SIGINT wf-recorder"
    },
{{- if eq .profile "bare-metal" }}
    "battery": {
        // Pin to the laptop battery only.
        //
        // Without this, the battery module enumerates every entry under
        // /sys/class/power_supply/ — including BT HID peripherals (mice,
        // keyboards) that show up as hidpp_battery_N. waybar's battery
        // module doesn't gracefully handle those entries appearing and
        // disappearing as the device sleeps/reconnects, and throws an
        // uncaught std::runtime_error ("Could not watch events for
        // /sys/class/power_supply/hidpp_battery_*") → std::terminate →
        // waybar dies entirely. Pinning to BAT0 avoids touching those
        // entries at all.
        //
        // Trade-off: you lose the "cool" peripheral-battery-in-the-bar
        // feature. If a future waybar release handles transient
        // power_supply devices safely, drop this line to get it back.
        "bat": "BAT0",
        "format": "<span font='JetBrainsMono Nerd Font 14'>{icon}</span>",
        "format-alt": "<span font='JetBrainsMono Nerd Font 14'>{icon}</span> {capacity}%",
        "format-alt-click": "click-left",
        "format-charging": "<span font='JetBrainsMono Nerd Font 14'>{icon}</span>",
        "format-full": "<span font='JetBrainsMono Nerd Font 14'>󰁹</span>",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "format-time": "{H}h:{M}m",
        "tooltip-format": "{capacity}% • {time}",
        "interval": 15,
        "states": {
            "warning": 25,
            "critical": 10
        }
    },
    "backlight": {
        "format": "<span font='JetBrainsMono Nerd Font 14'>{icon}</span> {percent}%",
        "format-icons": ["󰃚", "󰃜", "󰃝", "󰃞", "󰃠"],
        "tooltip-format": "Brightness: {percent}%",
        "on-scroll-up": "light -A 1",
        "on-scroll-down": "light -U 1"
    },
{{- end }}
    "network": {
        "format-wifi": "<span font='JetBrainsMono Nerd Font 14'>{icon}</span>",
        "format-ethernet": "<span font='JetBrainsMono Nerd Font 14'>󰈀</span>",
        "format-disconnected": "<span font='JetBrainsMono Nerd Font 14'>󰤪</span>",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr} • {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
{{- if eq .profile "bare-metal" }}
        "on-click": "networkmanager_dmenu"
{{- end }}
    },
    "pulseaudio": {
        "format": "<span font='JetBrainsMono Nerd Font 14'>{icon}</span>",
        "format-muted": "<span font='JetBrainsMono Nerd Font 14'>󰸈</span>",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 2,
        "tooltip-format": "{desc} • {volume}%",
        "on-click": "pavucontrol"
    },
    "temperature": {
        "critical-threshold": 75,
        "interval": 5,
        "format": "<span font='JetBrainsMono Nerd Font 14'>{icon}</span> {temperatureC}°",
        "format-icons": ["", "", "", "", "", "", "", "", "", ""],
        "tooltip-format": "Temp: {temperatureC}°C  •  critical at 75°C"
    },
{{- if eq .profile "bare-metal" }}
    "bluetooth": {
        "format": "<span font='JetBrainsMono Nerd Font 14'>󰂯</span>",
        "format-connected": "<span font='JetBrainsMono Nerd Font 14'>󰂰</span> {num_connections}",
        "format-off": "<span font='JetBrainsMono Nerd Font 14'>󰂱</span>",
        "format-disabled": "",
        "tooltip-format": "{controller_alias} ({controller_address})",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  {device_alias}",
        "on-click": "blueman-manager"
    }
{{- end }}
}
