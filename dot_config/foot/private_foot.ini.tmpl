{{- $t := index .themes .theme -}}
# Foot Terminal Configuration - managed by chezmoi
# Theme: {{ $t.name }}
include=/usr/share/foot/themes/{{ $t.terminal_theme }}

[main]
font=JetBrainsMono Nerd Font:size=12
font-bold=JetBrainsMono Nerd Font:weight=bold:size=12
font-italic=JetBrainsMono Nerd Font:slant=italic:size=12
font-bold-italic=JetBrainsMono Nerd Font:weight=bold:slant=italic:size=12
dpi-aware=yes
pad=8x8

[bell]
urgent=no
notify=no

[scrollback]
lines=10000

[cursor]
style=beam
blink=yes

[colors-dark]
alpha=0.90
