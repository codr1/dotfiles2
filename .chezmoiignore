# Don't deploy repo files to home dir
README.md

# Ignore swaylock on WSL and VM (no lock screen needed)
{{ if ne .profile "bare-metal" }}
.config/swaylock
.config/swaylock/config
{{ end }}

# networkmanager-dmenu is bare-metal only — VM/WSL inherit networking from host
# and don't have NetworkManager running anyway.
{{ if ne .profile "bare-metal" }}
.config/networkmanager-dmenu
.config/networkmanager-dmenu/config.ini
{{ end }}

# Power management stack — bare-metal only (no battery / AC concept on VM/WSL).
{{ if ne .profile "bare-metal" }}
.local/bin/swayidle-launcher
.local/bin/idle-dim
.local/bin/idle-undim
.local/bin/idle-screen-off
.local/bin/idle-screen-on
.local/bin/auto-power-profile
.config/systemd/user/swayidle.service
.config/systemd/user/auto-power-profile.service
.config/systemd/user/auto-power-profile.timer
run_once_after_install-power.sh
{{ end }}

# Ignore picom on non-i3 (sway has built-in compositor)
{{ if ne .wm "i3" }}
.config/picom
.config/picom/picom.conf
{{ end }}

# Ignore polybar on non-i3 (sway uses waybar)
{{ if ne .wm "i3" }}
.config/polybar
.config/polybar/config.ini
.config/polybar/launch.sh
{{ end }}

# Ignore rofi on non-i3 (sway uses wofi)
{{ if ne .wm "i3" }}
.config/rofi
.config/rofi/config.rasi
{{ end }}

# WSL-only: clipboard sync scripts, sway launcher, host-setup helper, systemd unit
{{ if ne .profile "wsl" }}
.local/bin/start-sway
.local/bin/clipboard-to-win
.local/bin/win-to-clipboard
.local/bin/setup-sway-wsl
.config/systemd/user/win-to-clipboard.service
{{ end }}
