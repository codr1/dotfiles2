#!/bin/bash
#
# clipboard-to-win — push wayland clipboard selection to Windows clipboard.
#
# Vendored from https://github.com/jordankoehn/sway-wsl2 (MIT).
#
# Invoked by `wl-paste --watch` (see sway/config) — receives new selection on
# stdin. Sentinel file in /tmp coordinates with win-to-clipboard to avoid
# echoing what we just received from Windows back into Windows.

CLIPBOARD_TO_WIN=/tmp/clipboard-to-win
WIN_TO_CLIPBOARD=/tmp/win-to-clipboard

if [[ -f $WIN_TO_CLIPBOARD ]]; then
  rm $WIN_TO_CLIPBOARD
else
  touch $CLIPBOARD_TO_WIN
  /mnt/c/windows/system32/clip.exe
fi
